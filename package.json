{
  "name": "shiorbit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "ローカル Markdown ノートアプリ（Obsidian 互換）",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:types": "tsc --noEmit",
    "check": "npm run check:boundary && npm run check:types && vitest run",
    "icon:build": "electron scripts/build-icon.cjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "electron:start": "electron .",
    "electron:dev": "set SHIORBIT_DEV_URL=http://localhost:5173&& electron .",
    "electron:build": "npm run build && electron-builder --win",
    "electron:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "d3-force": "^3.0.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/d3-force": "^3.0.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "main": "electron/main.cjs"
}
